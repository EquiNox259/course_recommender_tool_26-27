{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://course-recommender-dav-ten.vercel.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://courserecommendertool26-27-production.up.railway.app/api/$1" },
    { "source": "/documentation", "destination": "/documentation.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
